        <mxCell id="irVmWh2H2feQoBVotSHI-41" value="Le linee tratteggiate sono il percorso dei dati dal db verso l&#39;esterno. Le frecce normali sono i collegamenti nei moduli previsti dal pattern 3-layer che stiamo adottando come architettura generale del backend" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
