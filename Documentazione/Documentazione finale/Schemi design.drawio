          <mxGeometry x="30" width="510" height="300" as="geometry" />
        </mxCell>
        <mxCell id="TFcktgsDKx9lrRnR8x_w-30" value="&lt;div style=&quot;text-align: start; font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 14px; line-height: 20px;&quot;&gt;&lt;li&gt;&lt;p&gt;&lt;strong&gt;controller&lt;/strong&gt;&lt;br&gt;Espone gli endpoint REST (&lt;code&gt;/issues&lt;/code&gt;, &lt;code&gt;/users&lt;/code&gt;, ecc.)&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;strong&gt;service&lt;/strong&gt;&lt;br&gt;Contiene &lt;strong&gt;tutta la logica applicativa&lt;/strong&gt; (validazioni, filtri, assegnazioni, ricerca)&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;strong&gt;repository&lt;/strong&gt;&lt;br&gt;Isola l’accesso ai dati (Repository = DAO moderno)&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;strong&gt;model&lt;/strong&gt;&lt;br&gt;Entity + enum di dominio (&lt;code&gt;Issue&lt;/code&gt;, &lt;code&gt;User&lt;/code&gt;, &lt;code&gt;IssueStatus&lt;/code&gt;, ecc.)&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;strong&gt;dto&lt;/strong&gt;&lt;br&gt;Contratti API (input / output)&lt;/p&gt;&lt;/li&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="TFcktgsDKx9lrRnR8x_w-37" vertex="1">
          <mxGeometry y="130" width="600" height="30" as="geometry" />
        </mxCell>
