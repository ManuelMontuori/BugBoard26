<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="20.0" styleClass="secondary-content" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.frontend.viewsControllers.AssignedIssueViewController">

    <Label styleClass="title-dashboard" text="Assegna Issue" />

    <HBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="16.0" VBox.vgrow="ALWAYS">
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
         <content>
      
              <!-- Card sinistra: selezione issue + dettagli -->
              <VBox minWidth="0" spacing="14.0" styleClass="card">
      
                  <Label styleClass="card-title" text="Dettaglio Issue" />
      
                  <!-- ComboBox selezione issue -->
                  <VBox spacing="6.0">
                      <Label styleClass="form-label" text="Seleziona issue da assegnare" />
                      <ComboBox fx:id="comboIssue" maxWidth="1.7976931348623157E308" promptText="Scegli una issue..." styleClass="combo-box" />
                  </VBox>
      
                  <Separator />
      
                  <!-- Dettagli — nascosti finché non si sceglie una issue -->
                  <VBox fx:id="dettagliPane" managed="false" spacing="14.0" visible="false">
      
                      <VBox spacing="4.0">
                          <Label styleClass="form-label" text="Titolo" />
                          <Label fx:id="lblTitolo" styleClass="fval" wrapText="true" />
                      </VBox>
      
                      <VBox spacing="4.0">
                          <Label styleClass="form-label" text="Descrizione" />
                          <Label fx:id="lblDescrizione" styleClass="label-muted" wrapText="true" />
                      </VBox>
      
                      <HBox spacing="16.0">
                          <VBox spacing="4.0">
                              <Label styleClass="form-label" text="Tipo" />
                              <Label fx:id="lblTipo" styleClass="badge" />
                          </VBox>
                          <VBox spacing="4.0">
                              <Label styleClass="form-label" text="Priorità" />
                              <Label fx:id="lblPriorita" styleClass="badge" />
                          </VBox>
                          <VBox spacing="4.0">
                              <Label styleClass="form-label" text="Stato" />
                              <Label fx:id="lblStato" styleClass="badge" />
                          </VBox>
                      </HBox>
      
                  </VBox>
      
              </VBox>
         </content>
      </ScrollPane>
      <ScrollPane fitToWidth="true" hbarPolicy="ALWAYS" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS">
         <content>
         
                       <!-- Card destra: selezione utente -->
              <VBox minWidth="0" spacing="12.0" styleClass="card">
         
                           <Label styleClass="card-title" text="Seleziona membro del team" />
         
                           <Label fx:id="lblAiSuggerimento" styleClass="ai-chip" wrapText="true" />
         
                           <VBox fx:id="listUtenti" spacing="6.0" VBox.vgrow="ALWAYS" />
         
                           <Separator />
         
                           <HBox alignment="CENTER_RIGHT" spacing="10.0">
                      <Button mnemonicParsing="false" onAction="#onAnnullaClicked" styleClass="btn-secondary" text="Annulla" />
                      <Button fx:id="btnAssegna" mnemonicParsing="false" onAction="#onAssegnaClicked" styleClass="btn-primary" text="Assegna" />
                  </HBox>
         
                       </VBox>
         </content>
      </ScrollPane>

    </HBox>
</VBox>
